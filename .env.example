# Bubble app root, including the branch segment (version-test or version-<branch>)
BASE_URL=https://your-app.bubbleapps.io/version-test

# Path of the login page within the app
LOGIN_PATH=/login_page

# Dedicated test user credentials
TEST_USER_EMAIL=test-user@example.com
TEST_USER_PASSWORD=change-me

# Optional: only needed when the Bubble app itself is password-protected
# (Settings > General > Password protection). This is NOT the app user login.
APP_USERNAME=
APP_PASSWORD=

# Optional: Settings > API > private key. Leave empty to disable Data API helpers.
BUBBLE_API_TOKEN=

# Optional: data type used by tests/records.spec.ts (lowercase, no spaces)
BUBBLE_TEST_TYPE=

# Optional: JSON fields for the create/delete example, e.g. {"Name":"QA record"}
BUBBLE_TEST_FIELDS=

# Optional: milliseconds between browser actions, for watching headed runs
# SLOW_MO=500
